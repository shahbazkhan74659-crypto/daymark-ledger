{
  "name": "daymark-ledger-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Daymark Ledger backend REST API (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:format": "prisma format --config prisma7.config.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "prisma:studio": "prisma studio --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
