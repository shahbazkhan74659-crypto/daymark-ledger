// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id          String   @id @default(cuid())
  hashedToken String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  HALF
  ABSENT
}

enum RepaymentBucket {
  MONTH
  YEAR
}

model Worker {
  id                  String               @id @default(cuid())
  employeeCode        String               @unique
  fullName            String
  designation         String
  contact             String
  joiningDate         DateTime             @db.Date
  perDayRate          Decimal              @db.Decimal(10, 2)
  status              WorkerStatus         @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attendances         Attendance[]
  advances            Advance[]
  documents           WorkerDocument[]
  advanceRepayments   AdvanceRepayment[]
}

model Attendance {
  id        String           @id @default(cuid())
  workerId  String
  worker    Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([workerId, date])
  @@index([date])
}

model Advance {
  id        String   @id @default(cuid())
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, date])
  @@index([date])
}

model WorkerDocument {
  id           String   @id @default(cuid())
  workerId     String
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([workerId])
}

model ReportFieldPreference {
  id        String   @id @default(cuid())
  name      String
  fields    Json
  createdAt DateTime @default(now())
}

model AdvanceRepayment {
  id        String          @id @default(cuid())
  workerId  String
  worker    Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  bucket    RepaymentBucket
  date      DateTime        @db.Date
  amount    Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now())

  @@index([workerId, bucket])
  @@index([date])
}
