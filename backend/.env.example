PORT=3001
# Unused in production (frontend + backend are one same-origin Vercel
# project, so no cross-origin requests ever occur); kept for local dev's
# cors() middleware default, though the Vite proxy makes it a no-op there too.
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/daymark_ledger_dev"

# Set to "production" on Vercel — switches the session cookie to Secure
# (requires HTTPS). Vercel sets this automatically for production deploys.
NODE_ENV=development

# Seed credentials for the single admin account (Phase 7) — set your own values,
# never commit real credentials here.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Object storage for worker documents (Cloudinary — documents are jpg/jpeg
# images only, see documents.ts's allow-list). Local dev can point at the
# same real account too; there is no local-disk fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
